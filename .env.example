GROQ_API_KEY=your_key_here


JWT_SECRET=change-me


GROQ_MODEL=openai/gpt-oss-120b


POSTGRES_PASSWORD=ragpass

DATABASE_URL=postgresql+asyncpg://raguser:ragpass@127.0.0.1:5432/notebooklm

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=1000


COOKIE_SECURE=false

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Retrieval / chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

CHUNK_STRATEGY=structured
TOP_K=6
BROAD_TOP_K=12
CONTEXT_MAX_CHARS=18000
MAX_CHUNKS_PER_DOCUMENT=4
HISTORY_MESSAGES=6
RETRIEVE_K=30
QUERY_VARIANTS=2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
CONFIDENCE_HIGH=0.5
CONFIDENCE_LOW=0.05
SIMILARITY_HIGH=0.75
SIMILARITY_LOW=0.55
MIN_CITATION_COVERAGE=0.8

LOG_LEVEL=INFO
LOG_FORMAT=json


ENABLE_HYBRID_SEARCH=true

ENABLE_QUERY_REWRITE=true

# Off by default: with the reranker on it lowered Hit@1 and added ~1.5 s per question.
ENABLE_MULTI_QUERY=false

ENABLE_HYDE=false

ENABLE_RERANKER=true

ENABLE_ABSTENTION=true

ENABLE_PROMPT_INJECTION_SCAN=true

ENABLE_PII_REDACTION=true

# Give the model the chunks just before/after each chosen passage (same page and section).
ENABLE_NEIGHBOR_EXPANSION=true

# Reuse the stored answer when the same question is asked again over the same sources.
ENABLE_ANSWER_CACHE=true

# Write a short summary of each source after it is indexed (one small Groq call per source).
ENABLE_SOURCE_SUMMARIES=true

# --- Required -------------------------------------------------------------

# Groq API key for answer generation (free tier): https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Signs login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start while this is unset or still "change-me".
JWT_SECRET=change-me

# --- Optional -------------------------------------------------------------

# Chat model on Groq. Other options on the free tier include qwen/qwen3.8-27b.
GROQ_MODEL=openai/gpt-oss-120b

# Database. Docker Compose overrides the host to "db"; this value is for running
# the backend directly on your machine (see README, "Development").
POSTGRES_PASSWORD=ragpass
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@localhost:5432/notebooklm

# Uploaded PDFs (Docker stores them in the "uploads" volume).
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# Set to true only when serving over HTTPS.
COOKIE_SECURE=false

# Embeddings run locally (no API key). Changing the model requires a matching
# EMBEDDING_DIM and a new database migration.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Retrieval / chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=6
HISTORY_MESSAGES=6

# --- Required -------------------------------------------------------------

# Groq API key for answer generation (free tier): https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Signs login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start while this is unset or still "change-me".
JWT_SECRET=change-me

# --- Optional -------------------------------------------------------------

# Chat model on Groq. Other options on the free tier include qwen/qwen3.8-27b.
GROQ_MODEL=openai/gpt-oss-120b

# Database. Docker Compose overrides the host to "db"; this value is for running
# the backend directly on your machine (see README, "Development").
POSTGRES_PASSWORD=ragpass
# 127.0.0.1 rather than localhost: Compose publishes the port on IPv4 only, and on Windows
# "localhost" tries IPv6 first, adding ~2 s to every new connection.
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@127.0.0.1:5432/notebooklm

# Uploaded PDFs (Docker stores them in the "uploads" volume).
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=1000

# Set to true only when serving over HTTPS.
COOKIE_SECURE=false

# Embeddings run locally (no API key). Changing the model requires a matching
# EMBEDDING_DIM and a new database migration.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Retrieval / chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# structured = chunk within detected headings/sections; fixed = plain character window.
# After changing it, re-index: docker compose exec backend python -m app.reindex
CHUNK_STRATEGY=structured
TOP_K=6
BROAD_TOP_K=12
CONTEXT_MAX_CHARS=18000
MAX_CHUNKS_PER_DOCUMENT=4
HISTORY_MESSAGES=6
# Candidates per search, and how many the reranker scores before keeping TOP_K
RETRIEVE_K=30
# Paraphrases searched alongside the question (multi-query)
QUERY_VARIANTS=2
# Local cross-encoder (downloaded once; baked into the Docker image)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# Confidence: "high" needs a best reranker score (0-1) of CONFIDENCE_HIGH. "Low" (the answer
# abstains) needs both reranker < CONFIDENCE_LOW and best embedding similarity < SIMILARITY_LOW.
# With the reranker off, SIMILARITY_HIGH / SIMILARITY_LOW alone decide.
CONFIDENCE_HIGH=0.5
CONFIDENCE_LOW=0.05
SIMILARITY_HIGH=0.75
SIMILARITY_LOW=0.55
MIN_CITATION_COVERAGE=0.8

# Logging: json (one object per line, with request ids) or text (readable)
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Feature flags ----------------------------------------------------------
# Each optional retrieval stage can be switched off; the evaluation harness
# uses these to measure what every stage adds. GET /api/features lists them.

# false = vector search only, without keyword (full-text) search
ENABLE_HYBRID_SEARCH=true
# Rewrite follow-up questions into standalone ones using the chat history
ENABLE_QUERY_REWRITE=true
# Also search QUERY_VARIANTS paraphrases (same small LLM call as the rewrite)
ENABLE_MULTI_QUERY=true
# Also search with a short hypothetical answer (HyDE); off by default to save tokens
ENABLE_HYDE=false
# Rerank candidates with the local cross-encoder
ENABLE_RERANKER=true
# Answer "not in your sources" (with the nearest excerpts) when the best match is weak
ENABLE_ABSTENTION=true
# Quarantine retrieved passages containing high-confidence prompt injection patterns
ENABLE_PROMPT_INJECTION_SCAN=true
# Enables the per-notebook "Mask PII" setting (Aadhaar, PAN, email and Indian phone numbers)
ENABLE_PII_REDACTION=true

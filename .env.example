# Database
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@localhost:5432/notebooklm

# Embeddings (self-hosted, no API key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# LLM for answer generation via Groq (free tier: https://console.groq.com/keys)
GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Retrieval / chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=6
